{
  "name": "fleet-ledger-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fleet-ledger-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fleet-ledger-db --remote",
    "db:seed:local": "wrangler d1 execute fleet-ledger-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute fleet-ledger-db --remote --file=./seed.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
